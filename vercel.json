{
  "version": 2,
  "routes": [
    {
      "src": "/admin/?$",
      "dest": "/admin/login.html"
    },
    {
      "src": "/admin/dashboard/?$",
      "dest": "/admin/dashboard.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}